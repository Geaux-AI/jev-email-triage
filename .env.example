# Get a key from TypeSafe (Jev early access). Without it the app runs in mock mode.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Your real per million token prices, for the Est. cost box
PRICE_IN_PER_M=0.38
PRICE_OUT_PER_M=0.38

# Your real inbox (python3 import_gmail.py). Use a Gmail app password, not your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Then run on it with EMAILS_FILE=emails.gmail.json, and describe yourself so Jev knows what matters to you:
EMAILS_FILE=emails.json
JEV_ME=
